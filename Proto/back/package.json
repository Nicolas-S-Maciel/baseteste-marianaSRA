{
  "name": "mariana-front",
  "private": true,
  "description": "Build do CSS (Tailwind) usado pelos templates Thymeleaf do MarianaSRA",
  "scripts": {
    "dev": "tailwindcss -i ./src/main/frontend/styles.css -o ./src/main/resources/static/css/app.css --watch",
    "build": "tailwindcss -i ./src/main/frontend/styles.css -o ./src/main/resources/static/css/app.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
